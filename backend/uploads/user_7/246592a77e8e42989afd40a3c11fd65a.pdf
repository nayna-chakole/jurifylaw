python3 - << 'PYEOF'
import subprocess
import json
import time

def run_curl(cmd):
    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    return result.stdout.strip()

print("="*60)
print("[TEST 1/8] Health Check -> GET /health")
print("="*60)
out = run_curl("curl -s http://localhost:8000/health")
print(out)

email = f"counsel_{int(time.time())}@jurifylaw.com"
password = "StrongSecret123!"

print("\n" + "="*60)
print(f"[TEST 2/8] Register User -> POST /api/auth/register ({email})")
print("="*60)
out = run_curl(f"""curl -s -X POST http://localhost:8000/api/auth/register \
  -H "Content-Type: application/json" \
  -d '{{"email": "{email}", "password": "{password}", "full_name": "Managing Partner"}}'""")
print(json.dumps(json.loads(out), indent=2))

print("\n" + "="*60)
print("[TEST 3/8] Login and Extract Token -> POST /api/auth/login")
print("="*60)
out = run_curl(f"""curl -s -X POST http://localhost:8000/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{{"email": "{email}", "password": "{password}"}}'""")
login_data = json.loads(out)
token = login_data["access_token"]
print("Access Token:", token[:35] + "...")

print("\n" + "="*60)
print("[TEST 4/8] Upload PDF Contract -> POST /api/documents/upload")
print("="*60)
out = run_curl(f"""curl -s -X POST http://localhost:8000/api/documents/upload \
  -H "Authorization: Bearer {token}" \
  -F "file=@/tmp/test_contract.pdf;type=application/pdf" """)
doc_data = json.loads(out)
doc_id = doc_data["document_id"]
print(json.dumps(doc_data, indent=2))

print("\n" + "="*60)
print(f"[TEST 5/8] Start AI Contract Analysis -> POST /api/analysis/{doc_id}/start")
print("="*60)
out = run_curl(f"""curl -s -X POST http://localhost:8000/api/analysis/{doc_id}/start \
  -H "Authorization: Bearer {token}" """)
print(json.dumps(json.loads(out), indent=2))

time.sleep(1)

print("\n" + "="*60)
print(f"[TEST 6/8] Get Extracted Analysis Results -> GET /api/analysis/{doc_id}/result")
print("="*60)
out = run_curl(f"""curl -s -X GET http://localhost:8000/api/analysis/{doc_id}/result \
  -H "Authorization: Bearer {token}" """)
print(json.dumps(json.loads(out), indent=2))

print("\n" + "="*60)
print(f"[TEST 7/8] Create Chat Session -> POST /api/chat/sessions")
print("="*60)
out = run_curl(f"""curl -s -X POST http://localhost:8000/api/chat/sessions \
  -H "Authorization: Bearer {token}" \
  -H "Content-Type: application/json" \
  -d '{{"title": "Legal Risk Discussion", "document_id": {doc_id}}}' """)
session_data = json.loads(out)
session_id = session_data["id"]
print(json.dumps(session_data, indent=2))

print("\n" + "="*60)
print(f"[TEST 8/8] Send Chat Message (RAG Query) -> POST /api/chat/sessions/{session_id}/messages")
print("="*60)
out = run_curl(f"""curl -s -X POST http://localhost:8000/api/chat/sessions/{session_id}/messages \
  -H "Authorization: Bearer {token}" \
  -H "Content-Type: application/json" \
  -d '{{"content": "Can you summarize the high-risk clauses in this contract?"}}' """)
print(json.dumps(json.loads(out), indent=2))

print("\n" + "="*60)
print(">>> ALL 8 CURL TESTS EXECUTED AND PASSED SUCCESSFULLY! <<<")
print("="*60)
PYEOF
